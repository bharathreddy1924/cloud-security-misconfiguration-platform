# ==============================================================================
# CloudSec Platform Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure with your credentials:
# cp .env.example .env

# Server port (default: 3000 for local development, 3001 for Docker Compose host)
PORT=3000

# Environment mode (development | production | test)
NODE_ENV=development

# MongoDB Connection String
# (Optional: if omitted or offline, scanner runs in-memory without persistent history)
MONGODB_URI=mongodb://localhost:27017/cloudsec

# Session Secret (generate a secure random string of 32+ characters)
SESSION_SECRET=replace_with_a_secure_random_session_secret_32_chars_minimum

# Reverse Proxy Trust (set to 1 when operating behind Nginx reverse proxy)
TRUST_PROXY=1

# Cookie Security (false for plain HTTP, true for strict HTTPS, auto for dual HTTP/HTTPS behind Nginx)
COOKIE_SECURE=auto

# Google OAuth 2.0 Credentials
# Obtain these from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google OAuth Redirect Callback URI
# For local run without Docker: http://localhost:3000/auth/google/callback
# For Docker Compose HTTP:      http://localhost:3001/auth/google/callback
# For Docker Compose HTTPS:     https://localhost:3443/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
